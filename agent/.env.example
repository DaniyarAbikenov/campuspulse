# --- Gemini access: Vertex AI (production) or an AI Studio key (quick local runs) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=            # only with GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Agent configuration ---
CAMPUSPULSE_AGENT_MODEL=gemini-2.5-flash
CAMPUSPULSE_BACKEND_URL=http://127.0.0.1:8000/api/v1
# Streamable-HTTP URL of the Moodle MCP server (leave empty to run without Moodle tools).
CAMPUSPULSE_MOODLE_MCP_URL=http://127.0.0.1:8001/mcp
# Optional bearer for a protected MCP deployment (for example a Cloud Run identity token).
CAMPUSPULSE_MOODLE_MCP_TOKEN=
