# Base URL of the Moodle site, without a trailing slash.
CAMPUSPULSE_MOODLE_URL=https://moodle.example.com
# Web service token (Site administration > Server > Web services > Manage tokens).
CAMPUSPULSE_MOODLE_TOKEN=replace-with-the-web-service-token
# Required for streamable-http: clients must send "Authorization: Bearer <this value>".
# CAMPUSPULSE_MCP_API_KEY=
# Optional: "stdio" (default, for local agents) or "streamable-http" (for Cloud Run).
CAMPUSPULSE_MCP_TRANSPORT=stdio

# CampusPulse backend used by campuspulse-moodle-sync (proposes imports for approval).
CAMPUSPULSE_BACKEND_URL=http://127.0.0.1:8000/api/v1
# Bearer access token of the student, or enable the local demo login for development only.
CAMPUSPULSE_BACKEND_TOKEN=
CAMPUSPULSE_BACKEND_DEMO_LOGIN=false
