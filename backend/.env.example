CAMPUSPULSE_DATABASE_URL=sqlite:///./campuspulse.db
CAMPUSPULSE_API_V1_PREFIX=/api/v1
CAMPUSPULSE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
CAMPUSPULSE_JWT_SECRET=replace-with-at-least-32-random-bytes
CAMPUSPULSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CAMPUSPULSE_UPLOAD_DIRECTORY=storage/uploads
CAMPUSPULSE_MAX_UPLOAD_BYTES=20971520
CAMPUSPULSE_ENABLE_DEMO_AUTH=false

# AI agent (see README): disabled | vertex | adk_server
CAMPUSPULSE_AGENT_MODE=disabled
# CAMPUSPULSE_AGENT_PROJECT=your-gcp-project-id
# CAMPUSPULSE_AGENT_LOCATION=us-central1
# CAMPUSPULSE_AGENT_RESOURCE=projects/PROJECT/locations/us-central1/reasoningEngines/ID
